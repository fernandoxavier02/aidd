{
  "name": "@fx-studio-ai/aidd",
  "version": "2.0.0",
  "description": "AIDD — AI-Driven Development harness: project-agnostic context system + hooks + skills + gates for Claude Code, Codex, and any git repo (provider-neutral guard core, warn-tier Codex adapter, git pre-commit net). Installable per-project via `aidd init` (hybrid model: engine referenced from node_modules, editable docs scaffolded with a version manifest).",
  "type": "commonjs",
  "bin": {
    "aidd": "bin/aidd.cjs"
  },
  "files": [
    "bin/",
    "lib/",
    ".claude/hooks/",
    ".claude/skills/",
    ".claude/settings.json",
    ".claude/aidd-stop-rules.json",
    ".claude/aidd-phase-guard-config.json",
    ".claude/aidd-rls-config.json",
    ".claude/aidd-tdd-config.json",
    ".aidd/domain-map.json",
    ".aidd/domain-map.schema.json",
    ".aidd/current/CURRENT_TASK.template.md",
    "AIDD.md",
    "AIDD-RUNBOOK.md",
    "CONTEXT_INDEX.md",
    "PROJECT_BRIEF.md",
    "PREREQUISITES.md",
    "INSTALL.md",
    "CLAUDE.md",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:hooks": "node --test \"tests/hooks/*.test.cjs\"",
    "test:cli": "node --test \"tests/cli/*.test.cjs\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "aidd",
    "ai-driven-development",
    "claude-code",
    "codex",
    "tdd",
    "bdd",
    "ddd",
    "spec-driven",
    "harness",
    "template"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "license": "MIT"
}
