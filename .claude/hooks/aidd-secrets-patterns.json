{
  "$schema": "./aidd-secrets-patterns.schema.json",
  "version": "1.0.0",
  "description": "Secrets pattern catalog for aidd-secrets-guard. Add new families here; hook enforces >=12 entries at startup.",
  "patterns": [
    {
      "id": "openai-key",
      "regex": "sk-[a-zA-Z0-9_-]{20,}",
      "family": "OpenAI / Anthropic API key",
      "flags": ""
    },
    {
      "id": "anthropic-key",
      "regex": "sk-ant-[a-zA-Z0-9_-]{20,}",
      "family": "Anthropic API key",
      "flags": ""
    },
    {
      "id": "slack-bot",
      "regex": "xoxb-\\d+-\\d+-[a-zA-Z0-9]+",
      "family": "Slack bot token",
      "flags": ""
    },
    {
      "id": "slack-user",
      "regex": "xoxp-\\d+-\\d+-\\d+-[a-zA-Z0-9]+",
      "family": "Slack user token",
      "flags": ""
    },
    {
      "id": "slack-app",
      "regex": "xoxa-\\d+-[a-zA-Z0-9-]+",
      "family": "Slack app token",
      "flags": ""
    },
    {
      "id": "github-pat-classic",
      "regex": "ghp_[a-zA-Z0-9]{36}",
      "family": "GitHub PAT classic",
      "flags": ""
    },
    {
      "id": "github-pat-fine",
      "regex": "github_pat_[a-zA-Z0-9_]{82}",
      "family": "GitHub PAT fine-grained",
      "flags": ""
    },
    {
      "id": "aws-access-key",
      "regex": "AKIA[0-9A-Z]{16}",
      "family": "AWS access key",
      "flags": ""
    },
    {
      "id": "aws-secret-key",
      "regex": "aws_secret_access_key\\s*=\\s*['\"][a-zA-Z0-9/+=]{40}['\"]",
      "family": "AWS secret key",
      "flags": "i"
    },
    {
      "id": "jwt",
      "regex": "eyJ[a-zA-Z0-9_=\\-]+\\.eyJ[a-zA-Z0-9_=\\-]+\\.[a-zA-Z0-9_=\\-]+",
      "family": "JWT token",
      "flags": ""
    },
    {
      "id": "private-key",
      "regex": "-----BEGIN (RSA |EC |DSA |OPENSSH |)PRIVATE KEY-----",
      "family": "Private key (PEM)",
      "flags": ""
    },
    {
      "id": "pg-conn",
      "regex": "postgres(?:ql)?://[^:]+:[^@]+@",
      "family": "PostgreSQL connection string",
      "flags": "i"
    },
    {
      "id": "mongo-conn",
      "regex": "mongodb(?:\\+srv)?://[^:]+:[^@]+@",
      "family": "MongoDB connection string",
      "flags": "i"
    },
    {
      "id": "firebase-key",
      "regex": "firebase[_-]?api[_-]?key\\s*[:=]\\s*[\"'][\\w-]+[\"']",
      "family": "Firebase API key",
      "flags": "i"
    },
    {
      "id": "supabase-service",
      "regex": "(SUPABASE_SERVICE_ROLE_KEY|SUPABASE_JWT_SECRET)\\s*=\\s*[\"']?ey",
      "family": "Supabase service role / JWT secret",
      "flags": "i"
    }
  ]
}
